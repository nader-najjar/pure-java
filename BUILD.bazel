load("//:custom-rules.bzl", "checkstyle_test", "java_runtime_files", "spotbugs_test")
load("@rules_java//java:defs.bzl", "java_binary", "java_library", "java_test")
load("@rules_pkg//:pkg.bzl", "pkg_tar")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_image_index", "oci_load")

package(default_visibility = ["//visibility:private"])

exports_files([
    "checkstyle-configuration.xml",
    "java_runtime_notices.patch",
    "maven_install.json",
    "spotbugs-configuration.xml",
], visibility = ["//visibility:private"])

java_library(
    name = "app",
    srcs = glob(
        ["src/main/java/**/*.java"],
        exclude = [
            "src/main/java/io/template/Main.java",
            "src/main/java/io/template/composition/**/*.java",
        ],
    ),
    deps = [
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
        "@maven//:com_fasterxml_jackson_core_jackson_core",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:com_fasterxml_jackson_datatype_jackson_datatype_jsr310",
        "@maven//:com_google_guava_guava",
        "@maven//:com_google_inject_guice",
        "@maven//:org_glassfish_expressly_expressly",
        "@maven//:jakarta_validation_jakarta_validation_api",
        "@maven//:org_hibernate_validator_hibernate_validator",
        "@maven//:org_slf4j_slf4j_api",
        "@maven//:software_amazon_awssdk_regions",
        "@maven//:software_amazon_awssdk_dynamodb",
    ],
)

java_library(
    name = "composition",
    srcs = glob(["src/main/java/io/template/composition/**/*.java"]),
    deps = [
        ":app",
        "@maven//:com_google_inject_guice",
        "@maven//:software_amazon_awssdk_regions",
        "@maven//:software_amazon_awssdk_dynamodb",
    ],
)

java_library(
    name = "entrypoint",
    srcs = ["src/main/java/io/template/Main.java"],
    deps = [
        ":app",
        ":composition",
        "@maven//:com_google_inject_guice",
        "@maven//:org_slf4j_slf4j_api",
    ],
)

java_library(
    name = "logging",
    resources = glob(["src/main/resources/**"]),
    resource_strip_prefix = "src/main/resources",
    runtime_deps = ["@maven//:ch_qos_logback_logback_classic"],
)

java_binary(
    name = "app_bin",
    main_class = "io.template.Main",
    jvm_flags = ["-XX:MaxRAMPercentage=75.0"],
    stamp = 0,
    runtime_deps = [
        ":entrypoint",
        ":logging",
    ],
)

java_test(
    name = "all_tests",
    srcs = glob(["src/test/java/**/*.java"]),
    args = [
        "execute",
        "--select-package=io.template",
        "--fail-if-no-tests",
        "--disable-banner",
    ],
    jvm_flags = ["-XX:+EnableDynamicAgentLoading"],
    main_class = "org.junit.platform.console.ConsoleLauncher",
    use_testrunner = False,
    deps = [
        ":app",
        ":composition",
        "@maven//:com_github_spotbugs_spotbugs_annotations",
        "@maven//:com_google_inject_guice",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_junit_jupiter_junit_jupiter_params",
        "@maven//:org_mockito_mockito_core",
        "@maven//:org_mockito_mockito_junit_jupiter",
        "@maven//:software_amazon_awssdk_regions",
        "@maven//:software_amazon_awssdk_dynamodb",
    ],
    runtime_deps = [
        "@maven//:ch_qos_logback_logback_classic",
        "@maven//:org_junit_platform_junit_platform_console_standalone",
    ],
)

pkg_tar(
    name = "app_layer",
    tags = ["manual"],
    srcs = [":app_bin_deploy.jar"],
    package_dir = "/app",
)

java_runtime_files(
    name = "java_runtime_files",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"]
)

pkg_tar(
    name = "java_runtime_layer",
    srcs = [":java_runtime_files"],
    preserve_mode = True,
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//test/image:__pkg__"]
)

oci_image(
    name = "app_image_native",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
    base = select({
        "@platforms//cpu:x86_64": "@debian_linux_amd64",
        "@platforms//cpu:aarch64": "@debian_linux_arm64_v8"
    }),
    entrypoint = ["/opt/java/bin/java", "-jar"],
    cmd = ["/app/app_bin_deploy.jar"],
    env = {
        "JAVA_HOME": "/opt/java",
        "JAVA_TOOL_OPTIONS": "-XX:MaxRAMPercentage=75.0",
        "LANG": "C.UTF-8",
        "PATH": "/opt/java/bin:$PATH"
    },
    user = "65532:65532",
    workdir = "/app",
    tars = [":java_runtime_layer", ":app_layer"]
)

alias(
    name = "app_image_amd64",
    actual = ":app_image_native",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"]
)

alias(
    name = "app_image_arm64",
    actual = ":app_image_native",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:aarch64"]
)

oci_image_index(
    name = "app_image",
    tags = ["manual"],
    images = [":app_image_native"]
)

oci_load(
    name = "container_image",
    tags = ["manual"],
    format = "oci",
    image = ":app_image",
    repo_tags = ["template-pure-java:latest"],
)

filegroup(
    name = "container_tarball",
    tags = ["manual"],
    srcs = [":container_image"],
    output_group = "tarball",
)

java_binary(
    name = "checkstyle_bin",
    main_class = "com.puppycrawl.tools.checkstyle.Main",
    runtime_deps = ["@maven//:com_puppycrawl_tools_checkstyle"],
)

java_binary(
    name = "spotbugs_bin",
    main_class = "edu.umd.cs.findbugs.LaunchAppropriateUI",
    runtime_deps = ["@maven//:com_github_spotbugs_spotbugs"],
)

checkstyle_test(
    name = "checkstyle",
    srcs = [
        ":all_tests",
        ":app",
        ":composition",
        ":entrypoint",
    ],
)

spotbugs_test(
    name = "spotbugs",
    srcs = [
        ":all_tests",
        ":app",
        ":composition",
        ":entrypoint",
    ],
)
