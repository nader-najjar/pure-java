module(name = "template_pure_java", version = "1.0.0")

bazel_dep(name = "aspect_rules_lint", version = "2.9.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.1")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_python", version = "1.7.0")

# Include notices from the same pinned JDK archive in its runtime file set.
single_version_override(
    module_name = "rules_java",
    patches = ["//:java_runtime_notices.patch"],
    patch_strip = 1
)

register_toolchains("@rules_java//toolchains:all")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "ch.qos.logback:logback-classic:1.5.21",
        "com.fasterxml.jackson.core:jackson-annotations:2.20",
        "com.fasterxml.jackson.core:jackson-core:2.20.1",
        "com.fasterxml.jackson.core:jackson-databind:2.20.1",
        "com.fasterxml.jackson.datatype:jackson-datatype-jsr310:2.20.1",
        "com.github.spotbugs:spotbugs:4.10.4",
        "com.github.spotbugs:spotbugs-annotations:4.10.4",
        "com.google.guava:guava:33.4.8-jre",
        "com.google.inject:guice:7.0.0",
        "com.puppycrawl.tools:checkstyle:14.1.0",
        "org.glassfish.expressly:expressly:6.0.0",
        "jakarta.validation:jakarta.validation-api:3.1.1",
        "org.hibernate.validator:hibernate-validator:9.1.0.Final",
        "org.junit.jupiter:junit-jupiter:5.13.4",
        "org.junit.jupiter:junit-jupiter-api:5.13.4",
        "org.junit.jupiter:junit-jupiter-params:5.13.4",
        "org.junit.platform:junit-platform-console-standalone:1.13.4",
        "org.mockito:mockito-core:5.21.0",
        "org.mockito:mockito-junit-jupiter:5.21.0",
        "org.slf4j:slf4j-api:2.0.17",
        "software.amazon.awssdk:regions",
        "software.amazon.awssdk:dynamodb",
    ],
    boms = ["software.amazon.awssdk:bom:2.55.11"],
    fail_if_repin_required = True,
    known_contributing_modules = ["protobuf"],
    lock_file = "//:maven_install.json",
    repositories = ["https://repo.maven.apache.org/maven2"],
    version_conflict_policy = "pinned",
)
use_repo(maven, "maven")

linux = use_extension("@rules_oci//oci:extensions.bzl", "oci")
linux.pull(
    name = "debian",
    # Debian trixie-slim.
    digest = "sha256:f6b08b09a05725f9431502d3b5714f5c4576e82c1a84fa1debe0c24a7e0c3ec4",
    image = "index.docker.io/library/debian",
    platforms = ["linux/amd64", "linux/arm64/v8"]
)
use_repo(linux, "debian", "debian_linux_amd64", "debian_linux_arm64_v8")
